#compdef qrstash

_qrstash() {
  local -a commands
  commands=(
    'add:Create a new QR code'
    'show:Display QR code in terminal'
    'read:Show raw data of a QR code'
    'update:Update existing QR code data'
    'rename:Rename a QR code'
    'delete:Delete a QR code'
    'export:Export QR code as PNG image'
    'list:List all saved QR codes'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
  elif (( CURRENT == 3 )); then
    case "${words[2]}" in
      show|read|update|rename|delete|export)
        local -a qr_codes
        qr_codes=(${(f)"$(ls ~/.qrstash 2>/dev/null)"})
        if (( ${#qr_codes} > 0 )); then
          _describe 'qr code' qr_codes
        fi
        ;;
    esac
  elif (( CURRENT == 4 )); then
    case "${words[2]}" in
      export)
        _files -g '*.png'
        ;;
    esac
  fi
}

_qrstash
