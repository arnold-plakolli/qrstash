#compdef qrstash

_qrstash() {
  local commands="add show read update rename delete list"

  if [ "$CURRENT" -eq 2 ]; then
    _values 'command' add show read update rename delete list
  elif [ "$CURRENT" -eq 3 ]; then
    case "${words[2]}" in
      show|read|update|rename|delete)
        local qr_codes=($(ls ~/.qrstash 2>/dev/null))
        _values 'qr code' $qr_codes
        ;;
    esac
  fi
}

_qrstash
